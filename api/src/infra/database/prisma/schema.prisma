generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usuario {
  idUsuario              Int                  @id @default(autoincrement())
  nome                   String               @db.VarChar(45)
  email                  String               @unique(map: "email_UNIQUE") @db.VarChar(45)
  criado_em              DateTime             @default(now()) @db.DateTime(0)
  editado_em             DateTime             @default(now()) @db.DateTime(0)
  ativo                  Int                  @default(1) @db.TinyInt
  fkEmpresaId            Int?
  fkResponsavelTecnicoId Int?
  fkCargoId              Int?
  firebaseId             String               @unique
  cpf                    String?              @unique(map: "cpf_UNIQUE") @db.VarChar(12)
  telefone               String?
  assinatura             String?
  trocarsenha            Boolean              @default(true)
  aulas                  aulausuario[]
  progressoVideos        aulavideoprogresso[]
  avaliacoes             avaliacaousuario[]
  certificados           certificado[]
  cursoacessos           cursoacesso[]
  logevento              logevento[]
  acessosMateriais       materialacesso[]
  medidasvinculos        medidavinculo[]
  moduloacesso           moduloacesso[]
  cargo                  cargo?               @relation(fields: [fkCargoId], references: [idCargo], map: "fk_usuario_fkCargoId")
  empresa                empresa?             @relation(fields: [fkEmpresaId], references: [idEmpresa], map: "fk_usuario_fkEmpresaId")
  usuariohorario         usuariohorario[]
  usuariorole            usuariorole[]

  @@index([fkCargoId], map: "fk_usuario_fkCargoId")
  @@index([fkEmpresaId], map: "fk_usuario_fkEmpresaId")
}

model alternativa {
  idAlternativa Int        @id @default(autoincrement())
  texto         String     @db.Text
  correta       Int        @db.TinyInt
  criado_em     DateTime   @default(now()) @db.DateTime(0)
  editado_em    DateTime   @updatedAt @db.DateTime(0)
  ativo         Int        @default(1) @db.TinyInt
  fkPerguntaId  Int
  pergunta      pergunta   @relation(fields: [fkPerguntaId], references: [idPergunta], onDelete: Cascade, map: "fk_alternativa_fkPerguntaId")
  respostas     resposta[]

  @@index([fkPerguntaId], map: "fk_alternativa_fkPerguntaId")
}

model aula {
  idAula       Int                    @id @default(autoincrement())
  titulo       String                 @db.VarChar(45)
  descricao    String?                @db.Text
  tipo         aula_tipo
  duracao      Int
  ordem        Int
  criado_em    DateTime               @default(now()) @db.DateTime(0)
  editado_em   DateTime               @updatedAt @db.DateTime(0)
  ativo        Int                    @default(1) @db.TinyInt
  fkModuloId   Int
  modulo       modulo                 @relation(fields: [fkModuloId], references: [idModulo], onDelete: Cascade, map: "fk_aula_fkModuloId")
  steps        aulastep[]
  aulausuarios aulausuario[]
  videos       aulavideo[]
  avaliacoes   avaliacao[]
  materiais    materialcomplementar[]

  @@index([fkModuloId], map: "fk_aula_fkModuloId")
}

model aulastep {
  idAulaStep    Int                   @id @default(autoincrement())
  tipo          aulastep_tipo
  ordem         Int
  obrigatorio   Int                   @default(1) @db.TinyInt
  criado_em     DateTime              @default(now()) @db.DateTime(0)
  editado_em    DateTime              @updatedAt @db.DateTime(0)
  fkAulaId      Int
  fkMaterialId  Int?
  fkAulaVideoId Int?
  fkAvaliacaoId Int?
  aula          aula                  @relation(fields: [fkAulaId], references: [idAula], onDelete: Cascade)
  video         aulavideo?            @relation(fields: [fkAulaVideoId], references: [idAulaVideo], onDelete: Cascade)
  avaliacao     avaliacao?            @relation(fields: [fkAvaliacaoId], references: [idAvaliacao], onDelete: Cascade)
  material      materialcomplementar? @relation(fields: [fkMaterialId], references: [idMaterialComplementar], onDelete: Cascade)

  @@index([fkAulaId, ordem])
  @@index([fkAulaVideoId], map: "aulastep_fkAulaVideoId_fkey")
  @@index([fkAvaliacaoId], map: "aulastep_fkAvaliacaoId_fkey")
  @@index([fkMaterialId], map: "aulastep_fkMaterialId_fkey")
}

model aulausuario {
  idAulaUsuario   Int      @id @default(autoincrement())
  assistiuVideo   Int      @default(0) @db.TinyInt
  baixouMateriais Int      @default(0) @db.TinyInt
  respondeuQuiz   Int      @db.TinyInt
  concluida       Int      @db.TinyInt
  atualizado_em   DateTime @default(now()) @db.DateTime(0)
  criado_em       DateTime @default(now()) @db.DateTime(0)
  fkAulaId        Int
  fkUsuarioId     Int
  aula            aula     @relation(fields: [fkAulaId], references: [idAula], onDelete: Cascade, map: "fk_aulaUsuario_fkAulaId")
  usuario         usuario  @relation(fields: [fkUsuarioId], references: [idUsuario], onDelete: Cascade, map: "fk_aulaUsuario_fkUsuarioId")

  @@unique([fkAulaId, fkUsuarioId], name: "unique_fkAulaId_fkUsuarioId")
  @@index([fkAulaId], map: "fk_aulaUsuario_fkAulaId")
  @@index([fkUsuarioId], map: "fk_aulaUsuario_fkUsuarioId")
}

model aulavideo {
  idAulaVideo Int                  @id @default(autoincrement())
  url         String               @db.Text
  fkAulaId    Int
  steps       aulastep[]
  aula        aula                 @relation(fields: [fkAulaId], references: [idAula], onDelete: Cascade, map: "fk_aulaVideo_fkAulaId")
  progresso   aulavideoprogresso[]

  @@index([fkAulaId], map: "fk_aulaVideo_fkAulaId")
}

model aulavideoprogresso {
  idAulaVideoProgresso   Int       @id @default(autoincrement())
  fkUsuarioId            Int
  fkAulaVideoId          Int
  tempoAssistidoSegundos Int       @default(0)
  assistido              Boolean   @default(false)
  atualizado_em          DateTime  @updatedAt @db.DateTime(0)
  aulavideo              aulavideo @relation(fields: [fkAulaVideoId], references: [idAulaVideo], onDelete: Cascade)
  usuario                usuario   @relation(fields: [fkUsuarioId], references: [idUsuario], onDelete: Cascade)

  @@unique([fkUsuarioId, fkAulaVideoId])
  @@index([fkAulaVideoId])
}

model avaliacao {
  idAvaliacao        Int                     @id @default(autoincrement())
  fkCursoId          Int?
  fkModuloId         Int?
  fkAulaId           Int?
  titulo             String                  @db.VarChar(45)
  tempo_limite       Int
  tipoAplicacao      avaliacao_tipoAplicacao
  criado_em          DateTime                @default(now()) @db.DateTime(0)
  editado_em         DateTime                @updatedAt @db.DateTime(0)
  ativo              Int                     @default(1) @db.TinyInt
  steps              aulastep[]
  aula               aula?                   @relation(fields: [fkAulaId], references: [idAula], map: "fk_avaliacao_fkAulaId")
  curso              curso?                  @relation(fields: [fkCursoId], references: [idCurso], map: "fk_avaliacao_fkCursoId")
  modulo             modulo?                 @relation(fields: [fkModuloId], references: [idModulo], map: "fk_avaliacao_fkModuloId")
  avaliacoesUsuarios avaliacaousuario[]
  perguntas          pergunta[]

  @@index([fkAulaId], map: "fk_avaliacao_fkAulaId")
  @@index([fkCursoId], map: "fk_avaliacao_fkCursoId")
  @@index([fkModuloId], map: "fk_avaliacao_fkModuloId")
}

model avaliacaousuario {
  idAvaliacaoUsuario Int                     @id @default(autoincrement())
  dataInicio         DateTime                @default(now()) @db.DateTime(0)
  dataFim            DateTime?               @db.DateTime(0)
  nota               Float?                  @db.Float
  status             avaliacaousuario_status
  fkUsuarioId        Int
  fkAvaliacaoId      Int
  avaliacao          avaliacao               @relation(fields: [fkAvaliacaoId], references: [idAvaliacao], onDelete: Cascade, map: "fk_avaliacaoUsuario_fkAvaliacaoId")
  usuario            usuario                 @relation(fields: [fkUsuarioId], references: [idUsuario], onDelete: Cascade, map: "fk_avaliacaoUsuario_fkUsuarioId")
  respostas          resposta[]

  @@index([fkAvaliacaoId], map: "fk_avaliacaoUsuario_fkAvaliacaoId")
  @@index([fkUsuarioId], map: "fk_avaliacaoUsuario_fkUsuarioId")
}

model cargo {
  idCargo         Int             @id @default(autoincrement())
  nome            String          @db.VarChar(45)
  descricao       String          @db.Text
  criado_em       DateTime        @default(now()) @db.DateTime(0)
  editado_em      DateTime        @default(now()) @db.DateTime(0)
  ativo           Int             @default(1) @db.TinyInt
  fkSetorId       Int
  setor           setor           @relation(fields: [fkSetorId], references: [idSetor], onDelete: Cascade, map: "fk_cargo_fkSetorId")
  cursoacessos    cursoacesso[]
  medidasvinculos medidavinculo[]
  funcionarios    usuario[]

  @@index([fkSetorId], map: "fk_cargo_fkSetorId")
}

model categoria {
  idCategoria Int              @id @default(autoincrement())
  nome        String           @db.VarChar(45)
  descricao   String           @db.Text
  cursos      categoriacurso[]
}

model categoriacurso {
  idCategoriaCurso Int       @id @default(autoincrement())
  fkCursoId        Int
  fkCategoriaId    Int
  categoria        categoria @relation(fields: [fkCategoriaId], references: [idCategoria], onDelete: Cascade)
  curso            curso     @relation(fields: [fkCursoId], references: [idCurso], onDelete: Cascade)

  @@unique([fkCursoId, fkCategoriaId])
  @@index([fkCategoriaId], map: "categoriacurso_fkCategoriaId_fkey")
}

model cnae {
  idCnae       Int           @id @default(autoincrement())
  subclasse    String        @db.VarChar(45)
  descricao    String        @db.Text
  grauRisco    Int
  cnaevinculos cnaevinculo[]
}

model cnaevinculo {
  idCnaeVinculo Int      @id
  fkCnaeId      Int?
  fkEmpresaId   Int?
  fkUnidadeId   Int?
  cnae          cnae?    @relation(fields: [fkCnaeId], references: [idCnae])
  empresa       empresa? @relation(fields: [fkEmpresaId], references: [idEmpresa])
  unidade       unidade? @relation(fields: [fkUnidadeId], references: [idUnidade])

  @@index([fkCnaeId], map: "cnaevinculo_fkCnaeId_fkey")
  @@index([fkEmpresaId], map: "cnaevinculo_fkEmpresaId_fkey")
  @@index([fkUnidadeId], map: "cnaevinculo_fkUnidadeId_fkey")
}

model curso {
  idCurso                Int                @id @default(autoincrement())
  titulo                 String             @db.VarChar(45)
  descricao              String?            @db.Text
  cargaHoraria           Int
  criado_em              DateTime           @default(now()) @db.DateTime(0)
  editado_em             DateTime           @updatedAt @db.DateTime(0)
  ativo                  Int                @default(1) @db.TinyInt
  fkResponsavelTecnicoId Int
  fkEmpresaId            Int?
  avaliacoes             avaliacao[]
  categorias             categoriacurso[]
  certificados           certificado[]
  empresa                empresa?           @relation(fields: [fkEmpresaId], references: [idEmpresa], map: "fk_curso_fkEmpresaId")
  responsaveltecnico     responsaveltecnico @relation(fields: [fkResponsavelTecnicoId], references: [idResponsavelTecnico], onDelete: NoAction, map: "fk_curso_fkResponsavelTecnicoId")
  acessos                cursoacesso[]
  medidas                medidacurso[]
  modulos                modulo[]

  @@index([fkEmpresaId], map: "fk_curso_fkEmpresaId")
  @@index([fkResponsavelTecnicoId], map: "fk_curso_fkResponsavelTecnicoId")
}

model cursoacesso {
  idCursoAcesso Int       @id @default(autoincrement())
  fkCursoId     Int
  fkUsuarioId   Int?
  fkEmpresaId   Int?
  fkUnidadeId   Int?
  fkSetorId     Int?
  fkCargoId     Int?
  percentual    Float     @default(0) @db.Float
  concluido     Int       @default(0) @db.TinyInt
  dataInicio    DateTime? @db.DateTime(0)
  dataConclusao DateTime? @db.DateTime(0)
  atualizado_em DateTime  @updatedAt @db.DateTime(0)
  cargo         cargo?    @relation(fields: [fkCargoId], references: [idCargo])
  curso         curso     @relation(fields: [fkCursoId], references: [idCurso], onDelete: Cascade)
  empresa       empresa?  @relation(fields: [fkEmpresaId], references: [idEmpresa])
  setor         setor?    @relation(fields: [fkSetorId], references: [idSetor])
  unidade       unidade?  @relation(fields: [fkUnidadeId], references: [idUnidade])
  usuario       usuario?  @relation(fields: [fkUsuarioId], references: [idUsuario])

  @@unique([fkCursoId, fkEmpresaId, fkUnidadeId, fkSetorId, fkCargoId, fkUsuarioId], name: "uniq_cursoacesso_scope")
  @@unique([fkCursoId, fkUsuarioId], name: "fkUsuarioId_fkCursoId")
  @@index([fkCargoId], map: "cursoacesso_fkCargoId_fkey")
  @@index([fkEmpresaId], map: "cursoacesso_fkEmpresaId_fkey")
  @@index([fkSetorId], map: "cursoacesso_fkSetorId_fkey")
  @@index([fkUnidadeId], map: "cursoacesso_fkUnidadeId_fkey")
  @@index([fkUsuarioId], map: "cursoacesso_fkUsuarioId_fkey")
}

model empresa {
  idEmpresa           Int                   @id @default(autoincrement())
  nomeFantasia        String                @db.VarChar(45)
  razaoSocial         String                @db.VarChar(45)
  tipoDocumento       empresa_tipoDocumento
  documento           String                @db.VarChar(20)
  cep                 String                @db.VarChar(10)
  endereco            String                @db.VarChar(45)
  numero              String?               @db.VarChar(10)
  bairro              String                @db.VarChar(45)
  cidade              String                @db.VarChar(45)
  uf                  String                @db.VarChar(2)
  logoUrl             String?               @db.Text
  criado_em           DateTime              @default(now()) @db.DateTime(0)
  editado_em          DateTime              @default(now()) @db.DateTime(0)
  ativo               Int                   @default(1) @db.TinyInt
  complemento         String?               @db.VarChar(50)
  certificados        certificado[]
  certificadosEmpresa certificadoempresa[]
  cnaevinculos        cnaevinculo[]
  cursos              curso[]
  cursoacessos        cursoacesso[]
  medidas             medida[]
  medidasvinculos     medidavinculo[]
  unidades            unidade[]
  funcionarios        usuario[]
}

model materialcomplementar {
  idMaterialComplementar Int                       @id @default(autoincrement())
  titulo                 String                    @db.VarChar(45)
  tipo                   materialcomplementar_tipo
  material               String                    @db.Text
  criado_em              DateTime                  @default(now()) @db.DateTime(0)
  editado_em             DateTime                  @default(now()) @db.DateTime(0)
  ativo                  Int                       @default(1) @db.TinyInt
  fkAulaId               Int
  steps                  aulastep[]
  acessos                materialacesso[]
  aula                   aula                      @relation(fields: [fkAulaId], references: [idAula], onDelete: Cascade, map: "fk_materialComplementar_fkAulaId")

  @@index([fkAulaId], map: "fk_materialComplementar_fkAulaId")
}

model materialacesso {
  idMaterialAcesso Int                  @id @default(autoincrement())
  fkUsuarioId      Int
  fkMaterialId     Int
  visualizado      Boolean              @default(false)
  criado_em        DateTime             @default(now()) @db.DateTime(0)
  material         materialcomplementar @relation(fields: [fkMaterialId], references: [idMaterialComplementar], onDelete: Cascade)
  usuario          usuario              @relation(fields: [fkUsuarioId], references: [idUsuario], onDelete: Cascade)

  @@unique([fkUsuarioId, fkMaterialId])
  @@index([fkMaterialId])
}

model medida {
  idMedida       Int             @id @default(autoincrement())
  nome           String          @db.VarChar(45)
  tipo           medida_tipo
  descricao      String?         @db.Text
  ativo          Int             @default(1) @db.TinyInt
  fkEmpresaId    Int?
  empresa        empresa?        @relation(fields: [fkEmpresaId], references: [idEmpresa])
  cursos         medidacurso[]
  medidavinculos medidavinculo[]

  @@index([fkEmpresaId], map: "medida_fkEmpresaId_fkey")
}

model medidacurso {
  fkMedidaId Int
  fkCursoId  Int
  validade   Int
  curso      curso  @relation(fields: [fkCursoId], references: [idCurso], onDelete: Cascade)
  medida     medida @relation(fields: [fkMedidaId], references: [idMedida], onDelete: Cascade)

  @@id([fkMedidaId, fkCursoId])
  @@index([fkCursoId], map: "medidacurso_fkCursoId_fkey")
}

model medidavinculo {
  idMedidaVinculo Int      @id @default(autoincrement())
  fkMedidaId      Int
  fkEmpresaId     Int?
  fkUnidadeId     Int?
  fkSetorId       Int?
  fkCargoId       Int?
  fkUsuarioId     Int?
  cargo           cargo?   @relation(fields: [fkCargoId], references: [idCargo])
  empresa         empresa? @relation(fields: [fkEmpresaId], references: [idEmpresa])
  medida          medida   @relation(fields: [fkMedidaId], references: [idMedida], onDelete: Cascade)
  setor           setor?   @relation(fields: [fkSetorId], references: [idSetor])
  unidade         unidade? @relation(fields: [fkUnidadeId], references: [idUnidade])
  usuario         usuario? @relation(fields: [fkUsuarioId], references: [idUsuario])

  @@index([fkCargoId], map: "medidavinculo_fkCargoId_fkey")
  @@index([fkEmpresaId], map: "medidavinculo_fkEmpresaId_fkey")
  @@index([fkMedidaId], map: "medidavinculo_fkMedidaId_fkey")
  @@index([fkSetorId], map: "medidavinculo_fkSetorId_fkey")
  @@index([fkUnidadeId], map: "medidavinculo_fkUnidadeId_fkey")
  @@index([fkUsuarioId], map: "medidavinculo_fkUsuarioId_fkey")
}

model modulo {
  idModulo     Int            @id @default(autoincrement())
  titulo       String         @db.VarChar(45)
  cargaHoraria Int
  criado_em    DateTime       @default(now()) @db.DateTime(0)
  editado_em   DateTime       @updatedAt @db.DateTime(0)
  ativo        Int            @default(1) @db.TinyInt
  ordem        Int
  fkCursoId    Int
  aulas        aula[]
  avaliacoes   avaliacao[]
  curso        curso          @relation(fields: [fkCursoId], references: [idCurso], onDelete: Cascade, map: "fk_modulo_fkCursoId")
  moduloacesso moduloacesso[]

  @@index([fkCursoId], map: "fk_modulo_fkCursoId")
}

model moduloacesso {
  idModuloAcesso Int       @id @default(autoincrement())
  fkModuloId     Int
  fkUsuarioId    Int
  percentual     Float     @default(0) @db.Float
  concluido      Boolean   @default(false)
  dataConclusao  DateTime? @db.DateTime(0)
  criado_em      DateTime  @default(now()) @db.DateTime(0)
  editado_em     DateTime  @updatedAt @db.DateTime(0)
  modulo         modulo    @relation(fields: [fkModuloId], references: [idModulo], onDelete: Cascade)
  usuario        usuario   @relation(fields: [fkUsuarioId], references: [idUsuario], onDelete: Cascade)

  @@unique([fkModuloId, fkUsuarioId], name: "fkUsuarioId_fkModuloId")
  @@index([fkUsuarioId], map: "moduloacesso_fkUsuarioId_fkey")
}

model pergunta {
  idPergunta    Int           @id @default(autoincrement())
  enunciado     String        @db.Text
  tipo          pergunta_tipo
  criado_em     DateTime      @default(now()) @db.DateTime(0)
  editado_em    DateTime      @default(now()) @db.DateTime(0)
  ativo         Int           @default(1) @db.TinyInt
  fkAvaliacaoId Int
  alternativas  alternativa[]
  avaliacao     avaliacao     @relation(fields: [fkAvaliacaoId], references: [idAvaliacao], onDelete: Cascade, map: "fk_pergunta_fkAvalicaoId")
  respostas     resposta[]

  @@index([fkAvaliacaoId], map: "fk_pergunta_fkAvalicaoId")
}

model permissao {
  idPermissao   Int             @id @default(autoincrement())
  nome          String          @db.VarChar(45)
  descricao     String?         @db.Text
  rolepermissao rolepermissao[]
}

model responsaveltecnico {
  idResponsavelTecnico Int                              @id @default(autoincrement())
  nome                 String                           @db.VarChar(45)
  tipoDocumento        responsaveltecnico_tipoDocumento
  documento            String                           @db.VarChar(45)
  registro             String                           @db.VarChar(45)
  funcao               String                           @db.VarChar(45)
  telefone             String                           @db.VarChar(45)
  assinatura           String?                          @db.Text
  criado_em            DateTime                         @default(now()) @db.DateTime(0)
  editado_em           DateTime                         @default(now()) @db.DateTime(0)
  ativo                Int                              @default(1) @db.TinyInt
  cursos               curso[]
}

model resposta {
  idResposta           Int              @id @default(autoincrement())
  resposta             String           @db.Text
  dataResposta         DateTime         @default(now()) @db.DateTime(0)
  fkAvaliacaoUsuarioId Int
  fkAlternativaId      Int?
  fkPerguntaId         Int
  alternativa          alternativa?     @relation(fields: [fkAlternativaId], references: [idAlternativa], map: "fk_resposta_fkAlternativaId")
  avaliacaoUsuario     avaliacaousuario @relation(fields: [fkAvaliacaoUsuarioId], references: [idAvaliacaoUsuario], onDelete: Cascade, map: "fk_resposta_fkAvaliacaoUsuarioId")
  pergunta             pergunta         @relation(fields: [fkPerguntaId], references: [idPergunta], onDelete: Cascade, map: "fk_resposta_fkPerguntaId")

  @@index([fkAlternativaId], map: "fk_resposta_fkAlternativaId")
  @@index([fkAvaliacaoUsuarioId], map: "fk_resposta_fkAvaliacaoUsuarioId")
  @@index([fkPerguntaId], map: "fk_resposta_fkPerguntaId")
}

model role {
  idRole        Int             @id @default(autoincrement())
  nome          String          @db.VarChar(45)
  rolepermissao rolepermissao[]
  usuariorole   usuariorole[]
}

model rolepermissao {
  fkRoleId      Int
  fkPermissaoId Int
  permissao     permissao @relation(fields: [fkPermissaoId], references: [idPermissao], onDelete: Cascade, map: "fk_rolepermissao_fkPermissaoId")
  role          role      @relation(fields: [fkRoleId], references: [idRole], onDelete: Cascade, map: "fk_rolepermissao_fkRoleId")

  @@id([fkRoleId, fkPermissaoId])
  @@index([fkPermissaoId], map: "fk_rolepermissao_fkPermissaoId")
}

model setor {
  idSetor         Int             @id @default(autoincrement())
  nome            String          @db.VarChar(45)
  descricao       String          @db.Text
  ambiente        String?         @db.Text
  criado_em       DateTime        @default(now()) @db.DateTime(0)
  editado_em      DateTime        @default(now()) @db.DateTime(0)
  ativo           Int             @default(1) @db.TinyInt
  fkUnidadeId     Int
  cargos          cargo[]
  cursoacessos    cursoacesso[]
  medidasvinculos medidavinculo[]
  unidade         unidade         @relation(fields: [fkUnidadeId], references: [idUnidade], onDelete: Cascade, map: "fk_setor_fkUnidadeId")

  @@index([fkUnidadeId], map: "fk_setor_fkUnidadeId")
}

model unidade {
  idUnidade       Int                   @id @default(autoincrement())
  nomeFantasia    String                @db.VarChar(45)
  razaoSocial     String                @db.VarChar(45)
  tipoDocumento   unidade_tipoDocumento
  documento       String                @db.VarChar(20)
  cep             String                @db.VarChar(10)
  endereco        String                @db.VarChar(45)
  numero          String?               @db.VarChar(10)
  bairro          String                @db.VarChar(45)
  cidade          String                @db.VarChar(45)
  uf              String                @db.VarChar(2)
  criado_em       DateTime              @default(now()) @db.DateTime(0)
  editado_em      DateTime              @default(now()) @db.DateTime(0)
  ativo           Int                   @default(1) @db.TinyInt
  copiarEmpresa   Int?                  @default(0) @db.TinyInt
  fkEmpresaId     Int
  complemento     String?               @db.VarChar(50)
  cnaevinculos    cnaevinculo[]
  cursoacessos    cursoacesso[]
  medidasvinculos medidavinculo[]
  setores         setor[]
  empresa         empresa               @relation(fields: [fkEmpresaId], references: [idEmpresa], onDelete: Cascade, map: "fk_unidade_fkEmpresaId")

  @@index([fkEmpresaId], map: "fk_unidade_fkEmpresaId")
}

model usuariorole {
  fkUsuarioId Int
  fkRoleId    Int
  role        role    @relation(fields: [fkRoleId], references: [idRole], onDelete: Cascade, map: "fk_usuariorole_fkRoleId")
  usuario     usuario @relation(fields: [fkUsuarioId], references: [idUsuario], onDelete: Cascade, map: "fk_usuariorole_fkUsuarioId")

  @@id([fkUsuarioId, fkRoleId])
  @@index([fkRoleId], map: "fk_usuariorole_fkRoleId")
}

model logevento {
  idLogEvento  Int      @id @default(autoincrement())
  fkUsuarioId  Int
  tipo         String
  descricao    String?  @db.Text
  entidade     String?
  entidade_id  Int?
  dados_antes  String?  @db.LongText
  dados_depois String?  @db.LongText
  criado_em    DateTime @default(now()) @db.DateTime(0)
  usuario      usuario  @relation(fields: [fkUsuarioId], references: [idUsuario], onDelete: NoAction, map: "fk_logEvento_fkUsuarioId")

  @@index([fkUsuarioId], map: "fk_logEvento_fkUsuarioId")
}

model usuariohorario {
  id            Int     @id @default(autoincrement())
  diaSemana     Int
  horarioInicio String
  horarioFim    String
  fkUsuarioId   Int
  permitido     Boolean @default(true)
  usuario       usuario @relation(fields: [fkUsuarioId], references: [idUsuario], onDelete: NoAction, map: "usuarioHorario_fkUsuarioId_fkey")

  @@unique([fkUsuarioId, diaSemana], map: "usuarioHorario_fkUsuarioId_diaSemana_key")
}

model certificado {
  idCertificado Int      @id @default(autoincrement())
  codigo        String?  @unique
  fkUsuarioId   Int
  fkCursoId     Int
  fkEmpresaId   Int
  dataGeracao   DateTime @default(now())
  urlArquivo    String?
  valido        Boolean  @default(true)
  curso         curso    @relation(fields: [fkCursoId], references: [idCurso], onDelete: NoAction)
  empresa       empresa  @relation(fields: [fkEmpresaId], references: [idEmpresa], onDelete: NoAction)
  usuario       usuario  @relation(fields: [fkUsuarioId], references: [idUsuario], onDelete: NoAction)

  @@index([fkCursoId], map: "certificado_fkCursoId_fkey")
  @@index([fkEmpresaId], map: "certificado_fkEmpresaId_fkey")
  @@index([fkUsuarioId], map: "certificado_fkUsuarioId_fkey")
}

model certificadoempresa {
  idCertificadoEmpresa Int     @id @default(autoincrement())
  fkEmpresaId          Int
  totalGerados         Int     @default(0)
  limiteMensal         Int?
  competencia          String
  empresa              empresa @relation(fields: [fkEmpresaId], references: [idEmpresa], onDelete: NoAction)

  @@unique([fkEmpresaId, competencia])
}

